<?xml version="1.0" encoding="utf-8"?>
<!-- Boîtiers Android anciens : leurs certificats racine ne connaissent pas
     Let's Encrypt (utilisé par OVH). On ajoute les racines ISRG à celles du système. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
